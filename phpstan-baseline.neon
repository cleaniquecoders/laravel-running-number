parameters:
	ignoreErrors:
		-
			message: '#^Trait CleaniqueCoders\\RunningNumber\\Concerns\\InteractsWithRunningNumber is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Concerns/InteractsWithRunningNumber.php

		-
			message: '#^Call to an undefined static method CleaniqueCoders\\RunningNumber\\Models\\RunningNumber\:\:create\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: src/Console/Commands/CreateRunningNumberCommand.php

		-
			message: '#^Call to an undefined static method CleaniqueCoders\\RunningNumber\\Models\\RunningNumber\:\:where\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: src/Console/Commands/CreateRunningNumberCommand.php

		-
			message: '#^Call to function is_object\(\) with CleaniqueCoders\\RunningNumber\\Enums\\ResetPeriod will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Console/Commands/CreateRunningNumberCommand.php

		-
			message: '#^Call to an undefined static method CleaniqueCoders\\RunningNumber\\Models\\RunningNumber\:\:where\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: src/Console/Commands/ResetRunningNumberCommand.php

		-
			message: '#^Call to function is_object\(\) with CleaniqueCoders\\RunningNumber\\Enums\\ResetPeriod will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Console/Commands/ResetRunningNumberCommand.php
